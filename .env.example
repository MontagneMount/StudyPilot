# Required: Your Google Gemini API Key (get one from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini LLM model to use (defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Optional: Gemini Embedding model for RAG (defaults to gemini-embedding-001)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional: SQLite database file path (defaults to data/studypilot.sqlite)
DB_PATH=data/studypilot.sqlite

# Optional: Server port (defaults to 3000)
PORT=3000
